# Vercel CLI uploads from this directory. Keep build artifacts out — a stale
# backend/build/lib/ copy will shadow the real sources during the Python build
# and silently deploy old code.
backend/build/
backend/*.egg-info/
backend/venv/
backend/.venv/
**/__pycache__/
*.pyc

frontend/node_modules/
frontend/.next/
frontend/playwright-report/
frontend/test-results/

playwright/
demo/
docs/
